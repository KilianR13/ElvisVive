  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: afd95096a7df08949b97925fc3f954c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogos
  dialogos:
  - 'Oye chico, creo que tienes potencial para poder ayudarnos '
  - 'Ponemos nuestras esperanzas en ti. '
  - "Esa espada que llevas parece especial, como imbuida en armon\xEDa "
  - "prueba a atacar con ella a distancia, a lo mejor hace alg\xFAn sonido. "
  - "Quiz\xE1s con el poder de la buena m\xFAsica podamos liberar a Elvis"
  - "y liberar la zona de la antim\xFAsica. "
  - "Deber\xEDas empezar con Paquirr\xEDn que est\xE1 aqu\xED en este pueblo"
  - ' [Con click izq atacas]'
  dialogosSeleccionados: 0000000001000000020000000300000004000000050000000600000007000000
  fullDialogue: "Oye chico, creo que tienes potencial para poder ayudarnos Ponemos
    nuestras esperanzas en tiEsa espada que llevas parece especial, como imbuida
    en armon\xEDaprueba a atacar con ella a distancia, a lo mejor hace alg\xFAn sonidoQuiz\xE1s
    con el poder de la buena m\xFAsica podamos liberar a Elvisy liberar la zona de
    la antim\xFAsicaDeber\xEDas empezar con Paquirr\xEDn que est\xE1 aqu\xED en este
    pueblo[Con click izq atacas]"
  canvasDialogos: {fileID: 538593495}
  alreadyTransfered: 0
